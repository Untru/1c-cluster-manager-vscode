{
  "name": "onec-cluster-manager",
  "displayName": "1C Cluster Manager",
  "description": "Управление кластерами 1С:Предприятия через RAS/rac из VS Code",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": ["ui"],
  "categories": ["Other"],
  "keywords": ["1c", "1с", "ras", "rac", "cluster"],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:onecClusters",
    "onView:onecRas",
    "onCommand:onecClusterManager.addConnection"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-backend.js",
    "test": "npm run build && node --test out/**/*.test.js",
    "package": "npx @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.6.0"
  },
  "contributes": {
    "commands": [
      { "command": "onecClusterManager.refresh", "title": "1C: Обновить дерево", "icon": "$(refresh)" },
      { "command": "onecClusterManager.addConnection", "title": "1C: Добавить подключение RAS", "icon": "$(add)" },
      { "command": "onecClusterManager.removeConnection", "title": "1C: Удалить подключение", "icon": "$(trash)" },
      { "command": "onecClusterManager.setClusterCredentials", "title": "1C: Указать администратора кластера", "icon": "$(key)" },
      { "command": "onecClusterManager.setInfobaseCredentials", "title": "1C: Указать администратора информационной базы", "icon": "$(key)" },
      { "command": "onecClusterManager.setBackendToken", "title": "1C: Указать токен backend" },
      { "command": "onecClusterManager.openDetails", "title": "1C: Показать подробности" },
      { "command": "onecClusterManager.terminateSession", "title": "1C: Завершить сеанс" },
      { "command": "onecClusterManager.interruptSession", "title": "1C: Прервать серверный вызов" },
      { "command": "onecClusterManager.disconnectConnection", "title": "1C: Разорвать соединение" },
      { "command": "onecClusterManager.turnOffProcess", "title": "1C: Выключить рабочий процесс" },
      { "command": "onecClusterManager.enableSessionLock", "title": "1C: Заблокировать начало сеансов" },
      { "command": "onecClusterManager.disableSessionLock", "title": "1C: Разрешить начало сеансов" },
      { "command": "onecClusterManager.enableScheduledJobsLock", "title": "1C: Заблокировать регламентные задания" },
      { "command": "onecClusterManager.disableScheduledJobsLock", "title": "1C: Разрешить регламентные задания" },
      { "command": "onecClusterManager.rasRefresh", "title": "1C: Обновить RAS", "icon": "$(refresh)" },
      { "command": "onecClusterManager.startRasApplication", "title": "1C: Запустить RAS как приложение", "icon": "$(play)" },
      { "command": "onecClusterManager.stopRasApplication", "title": "1C: Остановить RAS", "icon": "$(stop)" },
      { "command": "onecClusterManager.installRasService", "title": "1C: Установить службу RAS", "icon": "$(server-environment)" },
      { "command": "onecClusterManager.startRasService", "title": "1C: Запустить службу RAS", "icon": "$(play)" },
      { "command": "onecClusterManager.stopRasService", "title": "1C: Остановить службу RAS", "icon": "$(stop)" },
      { "command": "onecClusterManager.deleteRasService", "title": "1C: Удалить службу RAS", "icon": "$(trash)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "onecClusterManager", "title": "Кластеры 1С", "icon": "media/cluster.svg" }
      ]
    },
    "views": {
      "onecClusterManager": [
        { "id": "onecClusters", "name": "Кластеры", "icon": "media/cluster.svg", "contextualTitle": "Кластеры 1С" },
        { "id": "onecRas", "name": "RAS", "icon": "media/cluster.svg", "contextualTitle": "Управление RAS" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "onecClusters",
        "contents": "Подключения к RAS ещё не настроены.\n[Добавить подключение](command:onecClusterManager.addConnection)"
      }
    ],
    "menus": {
      "view/title": [
        { "command": "onecClusterManager.addConnection", "when": "view == onecClusters", "group": "navigation" },
        { "command": "onecClusterManager.refresh", "when": "view == onecClusters", "group": "navigation" },
        { "command": "onecClusterManager.startRasApplication", "when": "view == onecRas", "group": "navigation" },
        { "command": "onecClusterManager.installRasService", "when": "view == onecRas", "group": "navigation" },
        { "command": "onecClusterManager.rasRefresh", "when": "view == onecRas", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "onecClusterManager.removeConnection", "when": "view == onecClusters && viewItem == connection", "group": "inline" },
        { "command": "onecClusterManager.setClusterCredentials", "when": "view == onecClusters && viewItem == cluster", "group": "1_auth" },
        { "command": "onecClusterManager.setInfobaseCredentials", "when": "view == onecClusters && viewItem == infobase", "group": "1_auth" },
        { "command": "onecClusterManager.terminateSession", "when": "view == onecClusters && viewItem == session", "group": "2_manage" },
        { "command": "onecClusterManager.interruptSession", "when": "view == onecClusters && viewItem == session", "group": "2_manage" },
        { "command": "onecClusterManager.disconnectConnection", "when": "view == onecClusters && viewItem == racConnection", "group": "2_manage" },
        { "command": "onecClusterManager.turnOffProcess", "when": "view == onecClusters && viewItem == process", "group": "2_manage" },
        { "command": "onecClusterManager.enableSessionLock", "when": "view == onecClusters && viewItem == infobase", "group": "3_locks" },
        { "command": "onecClusterManager.disableSessionLock", "when": "view == onecClusters && viewItem == infobase", "group": "3_locks" },
        { "command": "onecClusterManager.enableScheduledJobsLock", "when": "view == onecClusters && viewItem == infobase", "group": "3_locks" },
        { "command": "onecClusterManager.disableScheduledJobsLock", "when": "view == onecClusters && viewItem == infobase", "group": "3_locks" },
        { "command": "onecClusterManager.startRasApplication", "when": "view == onecRas && viewItem == rasInstallation", "group": "1_manage" },
        { "command": "onecClusterManager.installRasService", "when": "view == onecRas && viewItem == rasInstallation", "group": "1_manage" },
        { "command": "onecClusterManager.stopRasApplication", "when": "view == onecRas && viewItem == rasApplication", "group": "1_manage" },
        { "command": "onecClusterManager.startRasService", "when": "view == onecRas && viewItem == rasService.stopped", "group": "1_manage" },
        { "command": "onecClusterManager.stopRasService", "when": "view == onecRas && viewItem == rasService.running", "group": "1_manage" },
        { "command": "onecClusterManager.deleteRasService", "when": "view == onecRas && viewItem =~ /rasService/", "group": "2_danger" }
      ]
    },
    "configuration": {
      "title": "1C Cluster Manager",
      "properties": {
        "onecClusterManager.backend.url": {
          "type": "string",
          "default": "http://127.0.0.1:32145",
          "description": "URL самостоятельного backend управления кластерами 1С"
        },
        "onecClusterManager.backend.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Автоматически запускать встроенный локальный backend"
        }
      }
    }
  },
  "files": [
    "out/**",
    "backend/**",
    "media/**",
    "package.json",
    "README.md",
    "LICENSE"
  ]
}
